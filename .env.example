# =============================================================
#  E-Commerce — ortam değişkenleri örneği
#  Bu dosyayı .env olarak kopyalayın; gerçek secret'ları doldurun.
#  .env dosyasını asla commit etmeyin.
# =============================================================

# JWT (Identity + Gateway + Order + Basket aynı secret)
JwtSettings__Secret=CHANGE_ME_min_32_chars_long_secret_key!!
Jwt__SecretKey=CHANGE_ME_min_32_chars_long_secret_key!!
JwtSettings__Issuer=IdentityAPI
JwtSettings__Audience=ECommerceClient

# Varsayılan admin (yalnızca ilk seed; Production'da zorunlu)
DefaultAdmin__Email=admin@example.com
DefaultAdmin__UserName=admin
DefaultAdmin__Password=CHANGE_ME_StrongPass1!

# Veritabanı
POSTGRES_PASSWORD=CHANGE_ME
ConnectionStrings__DefaultConnection=Host=postgres-db;Port=5432;Database=IdentityDB;Username=postgres;Password=CHANGE_ME

# RabbitMQ
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# SMTP (prod)
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=noreply@example.com
Smtp__Enabled=true

# Public URL'ler
NEXT_PUBLIC_API_GATEWAY_URL=https://e-commerce.example.com/api
NEXT_PUBLIC_SIGNALR_URL=https://e-commerce.example.com/signalr
Cors__AllowedOrigins=https://e-commerce.example.com,https://admin.e-commerce.example.com

# ASP.NET
ASPNETCORE_ENVIRONMENT=Production
