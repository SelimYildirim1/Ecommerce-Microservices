# =============================================================
#  E-Commerce — ortam değişkenleri örneği
#  Bu dosyayı .env olarak kopyalayın; gerçek secret'ları doldurun.
#  .env dosyasını asla commit etmeyin.
# =============================================================

# JWT (Identity + Gateway + Order + Basket aynı secret)
JwtSettings__Secret=CHANGE_ME_min_32_chars_long_secret_key!!
Jwt__SecretKey=CHANGE_ME_min_32_chars_long_secret_key!!
JwtSettings__Issuer=IdentityAPI
JwtSettings__Audience=ECommerceClient

# Varsayılan admin (yalnızca ilk seed; Production'da zorunlu)
DefaultAdmin__Email=admin@example.com
DefaultAdmin__UserName=admin
DefaultAdmin__Password=CHANGE_ME_StrongPass1!

# Veritabanı
POSTGRES_PASSWORD=CHANGE_ME
ConnectionStrings__DefaultConnection=Host=postgres-db;Port=5432;Database=IdentityDB;Username=postgres;Password=CHANGE_ME

# RabbitMQ
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# SMTP (prod)
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=noreply@example.com
Smtp__Enabled=true

# Public URL'ler (tek domain: nginx /gateway → API Gateway, /hubs → SignalR)
# Örnek: https://eticaret.yildirimsoft.com.tr
NEXT_PUBLIC_SITE_URL=https://e-commerce.example.com
NEXT_PUBLIC_API_GATEWAY_URL=https://e-commerce.example.com/gateway
NEXT_PUBLIC_SIGNALR_URL=https://e-commerce.example.com
INTERNAL_API_URL=http://api-gateway:8080
Cors__AllowedOrigins=https://e-commerce.example.com,https://admin.e-commerce.example.com

# Admin panel (docker compose build args — tarayıcıdan gateway'e)
ADMIN_NEXT_PUBLIC_API_URL=https://e-commerce.example.com/gateway/aggregator/admin
ADMIN_NEXT_PUBLIC_AUTH_URL=https://e-commerce.example.com/gateway/auth
ADMIN_NEXT_PUBLIC_MEDIA_URL=https://e-commerce.example.com/gateway/media
ADMIN_NEXT_PUBLIC_CATALOG_ADMIN_URL=https://e-commerce.example.com/gateway/catalog/admin
ADMIN_NEXT_PUBLIC_PROMOTION_URL=https://e-commerce.example.com/gateway/promotions/admin
ADMIN_NEXT_PUBLIC_SHIPPING_URL=https://e-commerce.example.com/gateway/shipping/admin

# Portainer (Docker izleme) — secrets/portainer_admin_password_hash bcrypt dosyasi
# Uretimde: docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'GUCLU_SIFRE' | cut -d: -f2
#   > secrets/portainer_admin_password_hash
# Erisim: https://VPS_IP:9443  veya https://portainer.DOMAIN (DNS + certbot)

# Ödeme (şu an Payment.API mock). Gerçek PSP bağlanırken kart verisi
# storefront'ta toplanmamalı; hosted checkout / 3D Secure kullanılmalı.
# Payment__Provider=mock
# Payment__Iyzico__ApiKey=
# Payment__Iyzico__SecretKey=
# Payment__Iyzico__BaseUrl=https://sandbox-api.iyzipay.com

# ASP.NET
ASPNETCORE_ENVIRONMENT=Production

# Storefront: varsayılan compose prod (`npm start`). Yerel hot-reload için:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up ecommerce.web
