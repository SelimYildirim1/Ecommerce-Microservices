[Dd]ebug/
[Xx]64/
[xx]86/
[Bb]uild/
[Aa]pp[Pp]ackages/
.fake/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
obj/
bin/

# Visual Studio Code
.vscode/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Environment config
.env
secrets/
/data/