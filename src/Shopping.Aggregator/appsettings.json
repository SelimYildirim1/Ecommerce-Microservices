{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq:5341" }
      }
    ]
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Services": {
    "OrderApi": "http://order-api:8080",
    "CatalogApi": "http://catalog-api:8080",
    "IdentityApi": "http://identity-api:8080"
  },
  "AllowedHosts": "*"
}
