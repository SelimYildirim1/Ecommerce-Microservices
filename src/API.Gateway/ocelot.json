{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/products",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5024 } ],
      "UpstreamPathTemplate": "/catalog/products",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT" ]
    },
    {
      "DownstreamPathTemplate": "/api/basket/{userName}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5038 } ],
      "UpstreamPathTemplate": "/basket/{userName}",
      "UpstreamHttpMethod": [ "GET", "DELETE" ],
      
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/api/basket",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5038 } ],
      "UpstreamPathTemplate": "/basket",
      "UpstreamHttpMethod": [ "POST" ],
      
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/api/basket/checkout",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5038 } ],
      "UpstreamPathTemplate": "/basket/checkout",
      "UpstreamHttpMethod": [ "POST" ],

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    }
    
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8000"
  }
}