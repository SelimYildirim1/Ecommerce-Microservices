            "PathPattern": "/api/admin/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "aggregator-cluster": {
        "Destinations": {
          "aggregator": {
            "Address": "http://shopping-aggregator:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://catalog-api:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket": {
