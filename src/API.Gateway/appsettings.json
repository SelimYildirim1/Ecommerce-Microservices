        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      "shipping-admin-route": {
        "ClusterId": "shipping-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/shipping/admin/{**catch-all}"
        },
