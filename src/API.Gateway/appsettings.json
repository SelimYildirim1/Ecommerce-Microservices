{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://ecommerce-seq" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": { "Application": "API.Gateway" }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "bu_benim_cok_gizli_sifrem_ecommerce_project_secret_key_12345"
  },
  "ReverseProxy": {
    "Routes": {
      "aggregator-admin-route": {
        "ClusterId": "aggregator-cluster",
        "Match": {
          "Path": "/aggregator/admin/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/aggregator/admin/{**catch-all}" }
        ]
      },
      "aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/aggregator/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/aggregator/{**catch-all}" }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/basket/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/basket/{**catch-all}" }
        ]
      },
      "basket-checkout-route": {
        "ClusterId": "basket-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/basket/checkout",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathPattern": "/api/basket/checkout" }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/orders/{**catch-all}" }
        ]
      },
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "aggregator-cluster": {
        "Destinations": {
          "aggregator": {
            "Address": "http://shopping-aggregator:8080"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://catalog-api:8080"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket": {
            "Address": "http://basket-api:8080"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order": {
            "Address": "http://order-api:8080"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://identity-api:8080"
          }
        }
      }
    }
  }
}
