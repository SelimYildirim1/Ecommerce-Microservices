{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://ecommerce-seq"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "API.Gateway"
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "bu_benim_cok_gizli_sifrem_ecommerce_project_secret_key_12345"
  },
  "ReverseProxy": {
    "Routes": {
      "aggregator-admin-route": {
        "ClusterId": "aggregator-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/aggregator/admin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/aggregator/admin/{**catch-all}"
          }
        ]
      },
      "aggregator-route": {
        "ClusterId": "aggregator-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/aggregator/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/aggregator/{**catch-all}"
          }
        ]
      },
      "media-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/media/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/media/{**catch-all}"
          }
        ]
      },
      "uploads-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/uploads/{**catch-all}"
          }
        ]
      },
      "static-img-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/img/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/img/{**catch-all}"
          }
        ]
      },
      "catalog-admin-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/catalog/admin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/admin/{**catch-all}"
          }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/basket/{**catch-all}"
